  {
   "id": 1,
   "type": "timeseries",
   "title": "Token Throughput - generation (decode side)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (engine_type) (rate(sglang:generation_tokens_total{engine_type=\"decode\"}[30s]))",
     "legendFormat": "{{engine_type}}",
     "interval": "1s"
    }
   ]
  },
