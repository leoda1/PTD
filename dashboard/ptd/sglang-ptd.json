{
 "uid": "sglang-pd-offline",
 "title": "SGLang P/D Offline Replay",
 "tags": [
  "sglang",
  "pd",
  "offline",
  "flagcx"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "kv_bytes_per_request",
    "label": "KV bytes/request",
    "type": "textbox",
    "query": "167772160",
    "current": {
     "selected": true,
     "text": "167772160",
     "value": "167772160"
    },
    "options": [
     {
      "selected": true,
      "text": "167772160",
      "value": "167772160"
     }
    ],
    "hide": 0,
    "skipUrlSync": false
