{
 "uid": "vllm-pd-offline",
 "title": "vLLM P/D Offline Replay",
 "tags": [
  "vllm",
  "pd",
  "offline"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "kv_bytes_per_request",
    "label": "KV bytes/request",
    "type": "textbox",
    "query": "167772160",
    "current": {
     "selected": true,
     "text": "167772160",
     "value": "167772160"
    },
    "options": [
     {
      "selected": true,
      "text": "167772160",
      "value": "167772160"
     }
    ],
    "hide": 0,
    "skipUrlSync": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Token Throughput - generation (decode side)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (rate(vllm:generation_tokens_total{instance=~\"decode.*\"}[30s]))",
     "legendFormat": "{{instance}}",
     "interval": "1s"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Token Throughput - prompt (prefill side)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (rate(vllm:prompt_tokens_total{instance=~\"prefill.*\"}[30s]))",
     "legendFormat": "{{instance}}",
     "interval": "1s"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Running / Waiting (concurrency, not req/s)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (vllm:num_requests_running)",
     "legendFormat": "running {{instance}}"
    },
    {
     "refId": "B",
     "expr": "sum by (instance) (vllm:num_requests_waiting)",
     "legendFormat": "waiting {{instance}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "KV Cache Usage",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (instance) (vllm:kv_cache_usage_perc)",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "TTFT Quantiles (prefill)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{instance=~\"prefill.*\"}[30s])))",
     "legendFormat": "p99"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{instance=~\"prefill.*\"}[30s])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{instance=~\"prefill.*\"}[30s])))",
     "legendFormat": "p50"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "ITL Quantiles (decode)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{instance=~\"decode.*\"}[30s])))",
     "legendFormat": "p99"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{instance=~\"decode.*\"}[30s])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{instance=~\"decode.*\"}[30s])))",
     "legendFormat": "p50"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "E2E Request Latency Quantiles",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(vllm:e2e_request_latency_seconds_bucket[30s])))",
     "legendFormat": "p99 {{instance}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.50, sum by (le, instance) (rate(vllm:e2e_request_latency_seconds_bucket[30s])))",
     "legendFormat": "p50 {{instance}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Prefix Cache Hit Rate",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (rate(vllm:prefix_cache_hits_total[30s])) / sum by (instance) (rate(vllm:prefix_cache_queries_total[30s]))",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Mean Request Time per Stage",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(vllm:request_prefill_time_seconds_sum[30s])) / sum(rate(vllm:request_prefill_time_seconds_count[30s]))",
     "legendFormat": "prefill"
    },
    {
     "refId": "B",
     "expr": "sum(rate(vllm:request_decode_time_seconds_sum[30s])) / sum(rate(vllm:request_decode_time_seconds_count[30s]))",
     "legendFormat": "decode"
    },
    {
     "refId": "C",
     "expr": "sum(rate(vllm:request_queue_time_seconds_sum[30s])) / sum(rate(vllm:request_queue_time_seconds_count[30s]))",
     "legendFormat": "queue"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Cumulative Preemptions",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (vllm:num_preemptions_total)",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "KV Cache Transfer Throughput (total + per engine)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(irate(vllm:flagcx_total_bytes_transferred_total{instance=~\"prefill.*\"}[5s]))",
     "legendFormat": "all prefill engines / TP ranks",
     "interval": "1s"
    },
    {
     "refId": "B",
     "expr": "sum by (instance, engine) (irate(vllm:flagcx_total_bytes_transferred_total{instance=~\"prefill.*\"}[5s]))",
     "legendFormat": "{{instance}} engine={{engine}}",
     "interval": "1s"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "KV Cache Cumulative Bytes Transferred",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(vllm:flagcx_total_bytes_transferred_total{instance=~\"prefill.*\"})",
     "legendFormat": "KV payload total"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Prefill / Decode Completion Throughput (req/s)",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 48
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(irate(vllm:request_success_total{instance=~\"prefill.*\",finished_reason!~\"abort|error\"}[5s]))",
     "legendFormat": "Prefill req/s",
     "interval": "1s"
    },
    {
     "refId": "B",
     "expr": "sum(irate(vllm:request_success_total{instance=~\"decode.*\",finished_reason!~\"abort|error\"}[5s]))",
     "legendFormat": "Decode req/s",
     "interval": "1s"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "KV Cache Equivalent Throughput (req/s)",
   "description": "KV bytes/request defaults to 167772160 (160 MiB). Derived from transferred-byte delta divided by completed-request delta over the same window.",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 56
   },
   "datasource": {
    "type": "prometheus",
    "uid": "promoffline"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(irate(vllm:flagcx_total_bytes_transferred_total{instance=~\"prefill.*\"}[5s])) / ${kv_bytes_per_request:raw}",
     "legendFormat": "KV equivalent req/s",
     "interval": "1s"
    }
   ]
  }
 ]
}
